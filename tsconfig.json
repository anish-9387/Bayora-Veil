{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@bayora/schemas": ["packages/schemas/src"],
      "@bayora/crypto-utils": ["packages/crypto-utils/src"]
    }
  },
  "exclude": ["node_modules", "dist", "**/dist/**"]
}