{
  "name": "bayora-veil",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm db:migrate && concurrently --kill-others --names api,web \"pnpm --filter=@bayora/api dev\" \"pnpm --filter=@bayora/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter=@bayora/api db:migrate",
    "db:seed": "pnpm --filter=@bayora/api db:seed",
    "docker:up": "docker-compose -f infra/docker-compose.yml up --build",
    "docker:down": "docker-compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "packageManager": "pnpm@9.0.0"
}
