FROM python:3.12-slim
WORKDIR /app
COPY services/target-adapter/pyproject.toml .
COPY services/target-adapter/requirements.lock .
RUN pip install --no-cache-dir -r requirements.lock && pip install --no-cache-dir --no-deps . && useradd --uid 10001 --create-home target
COPY --chown=target:target services/target-adapter/src ./src
USER target
ENV NODE_ENV=production PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EXPOSE 10000
CMD ["sh", "-c", "exec python -m uvicorn src.main:app --host 0.0.0.0 --port ${PORT:-10000} --no-access-log"]
